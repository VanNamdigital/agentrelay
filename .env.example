# Telegram Bot Token (lay tu @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bat buoc cho admin session. Dung chuoi dai, ngau nhien, khong commit gia tri that.
SESSION_SECRET=change_this_to_a_long_random_session_secret

# Danh sach ID Telegram duoc phep su dung bot, cach nhau bang dau phay.
# Co the lay ID bang cach nhan tin cho @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Danh sach project, cach nhau bang dau phay.
# Vi du: C:/path/project1,D:/path/project2
PROJECTS=G:/project1,G:/project2

# Lenh CLI OpenCode dang dung tren may. Bot se tu chay `opencode models`.
OPENCODE_COMMAND=opencode

# Lenh CLI Codex dang dung tren may. Mac dinh bot se goi truc tiep npm script neu tim thay.
CODEX_COMMAND=codex

# Lenh CLI khac. App scan se tu tim trong PATH va cac thu muc cai dat pho bien neu de trong.
CLAUDE_COMMAND=
GEMINI_COMMAND=
KIRO_COMMAND=
KILOCODE_COMMAND=
AIDER_COMMAND=
GOOSE_COMMAND=
GITHUB_COPILOT_COMMAND=
CRUSH_COMMAND=

# Tuy chon. Neu khong cau hinh, bot se uu tien model trong ~/.codex/config.toml roi them danh sach mac dinh.
CODEX_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3-codex
CLAUDE_MODELS=claude-3-5-sonnet,claude-3-7-sonnet,claude-sonnet-4,claude-opus-4

# Timeout moi task CLI, tinh bang phut. Mac dinh trong code la 120 neu khong cau hinh.
TASK_TIMEOUT_MINUTES=120

# Ngon ngu he thong: en, vi, ru, zh.
SYSTEM_LANGUAGE=en

# Admin dashboard Express server. Mac dinh chi bind localhost.
ADMIN_PORT=3456
HOST=127.0.0.1
ALLOW_LAN=false
AUTH_COOKIE_SECURE=false
ADMIN_CORS_ORIGINS=http://127.0.0.1:3456,http://localhost:3456,http://127.0.0.1:3000,http://localhost:3000

# Tuy chon: gioi han project path vao cac thu muc nay, cach nhau bang dau phay.
# De trong neu muon cho phep chon project o bat ky duong dan local nao.
PROJECTS_BASE_DIR=

# Provider API keys tuy chon. De trong neu CLI da tu quan ly credential rieng.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENCODE_API_KEY=

# Bot channels khac. Cac runtime nay hien duoc luu config de tich hop adapter sau.
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

ZALO_ENABLED=false
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_ACCESS_TOKEN=

DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

SLACK_ENABLED=false
SLACK_APP_ID=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

MESSENGER_ENABLED=false
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_WEBHOOK_VERIFY_TOKEN=

LINE_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

WECHAT_ENABLED=false
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_CALLBACK_TOKEN=
WECHAT_ENCODING_AES_KEY=

WEBCHAT_ENABLED=false
WEBCHAT_WIDGET_NAME=
WEBCHAT_ALLOWED_ORIGIN=
WEBCHAT_WIDGET_SECRET=
